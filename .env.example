# ==============================================================================
# PfsenseMon — Environment Configuration Template
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider & AI Configuration (Anthropic / MiniMax / Ollama / OpenAI / OpenRouter)
# ------------------------------------------------------------------------------
# Supported values for LLM_PROVIDER:
#   - anthropic   (Default: MiniMax or Official Anthropic via /v1/messages)
#   - ollama      (Local Ollama via /v1/chat/completions — no API key required)
#   - openai      (OpenAI Cloud, LM Studio, vLLM, or llama.cpp via /v1/chat/completions)
#   - openrouter  (OpenRouter multi-model gateway via https://openrouter.ai/api/v1)
LLM_PROVIDER=anthropic

# Option A: MiniMax / Anthropic (Default when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-minimax-or-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
ANTHROPIC_MODEL=MiniMax-M2.5

# Option B: Local Ollama (Uncomment and set LLM_PROVIDER=ollama)
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:14b

# Option C: OpenRouter (Uncomment and set LLM_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-v1-replace-with-your-openrouter-key
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemini-2.5-flash

# Option D: LM Studio / vLLM / OpenAI (Uncomment and set LLM_PROVIDER=openai)
# LLM_API_KEY=sk-optional-for-local-lm-studio
# LLM_BASE_URL=http://host.docker.internal:1234/v1
# LLM_MODEL=local-model

# HTTP timeout in seconds for LLM inference (increase for large local models on CPU/GPU)
LLM_TIMEOUT_SECONDS=90
# Enable OpenAI strict JSON Schema structured output (supported by LM Studio, OpenAI, vLLM)
LLM_STRUCTURED_OUTPUT=true
# Language used by the AI exclusively for the Telegram/Grafana human-readable security report
AI_REPORT_LANGUAGE=Italian
# Automatically enrich anomalous public IPs with GeoIP Country/City/ISP/ASN (set false for air-gapped mode)
ENABLE_GEOIP=true

# ------------------------------------------------------------------------------
# 2. Telegram Bot Configuration (Required for Mobile Alerts)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:AAF-replace-with-your-botfather-token
TELEGRAM_CHAT_ID=123456789
# Set to true to also send a notification even if Anthropic API fails (raw fallback)
TELEGRAM_ENABLE_RAW_FALLBACK=true

# ------------------------------------------------------------------------------
# 3. Network & Service Ports
# ------------------------------------------------------------------------------
# UDP port exposed on the Docker host to receive pfSense Syslog packets
VECTOR_SYSLOG_PORT=5140
# TCP port exposed on the Docker host for Grafana Data Source & Hermes Agent queries
LOKI_HTTP_PORT=3100
# Internal URL used by the Python Analyzer container to talk to Loki
LOKI_INTERNAL_URL=http://loki:3100

# Optional comma-separated list of pfSense physical WAN interface names (e.g., igb0,em0,vtnet0,pppoe0)
# Note: Vector also automatically detects WAN vs LAN using RFC1918 IP heuristics.
PFSENSE_WAN_INTERFACES=wan,igb0,em0,vtnet0,pppoe0,ix0,re0

# ------------------------------------------------------------------------------
# 4. Zero-Token Pre-Filter & Detection Thresholds
# ------------------------------------------------------------------------------
# How often (in minutes) the Python Analyzer checks Loki for security anomalies
ANALYSIS_INTERVAL_MINUTES=15

# Maximum look-back (in minutes) used to backfill analysis windows missed while the Docker
# host was suspended or the analyzer was offline (0 = only the last interval). Default: 24h.
MAX_CATCHUP_MINUTES=1440

# Minimum blocked hits from a single external IP within the interval to trigger Tier 3 AI analysis
WAN_BLOCK_HIT_THRESHOLD=50

# Minimum distinct destination ports targeted by a single external IP to flag a Port Scan
WAN_PORT_SCAN_THRESHOLD=8

# Minimum Tier 1 (Suspicious Outbound) events to trigger AI analysis (default: 1 = any suspicious outbound)
OUTBOUND_SUSPICIOUS_THRESHOLD=1

# Minimum Tier 2 (Auth / Allowed WAN) anomalous events to trigger AI analysis
AUTH_EVENT_THRESHOLD=1

# Cooldown period (in minutes) before re-alerting on the same (src_ip, tier) offender
ALERT_DEDUP_TTL_MINUTES=120

# Maximum number of top offenders/events included in the Claude prompt (protects token budget)
MAX_PROMPT_ITEMS_PER_TIER=25

# ------------------------------------------------------------------------------
# 5. Whitelists, Identity-Aware Known Flows & DHCP Lease Tracking
# ------------------------------------------------------------------------------
# Comma-separated internal LAN IPs, Hostnames, or MACs to ignore ONLY for Tier 1 allowed uncommon-port outbound checks (never hides blocked flows)
WHITELIST_INTERNAL_IPS=
# Comma-separated external IPs (e.g., your own remote static VPN client IP or monitoring server)
WHITELIST_EXTERNAL_IPS=
# Comma-separated outbound TCP/UDP destination ports considered benign/standard (excluded from Tier 1 pass alerts)
WHITELIST_OUTBOUND_PORTS=53,80,123,443,465,587,853,993,51820,1194
# Semicolon-separated granular flow rules: src>dst:port1,port2[/proto] where src/dst can be Hostname, MAC, or IP/CIDR
# Examples: apple-tv-salotto>192.168.1.50:8008,8009/tcp;00:00:5e:00:53:10>*:6881/udp
WHITELIST_FLOWS=
# Path to structured JSON file with hot-reloaded known flows and device descriptions (see config/known_flows.example.json)
KNOWN_FLOWS_PATH=config/known_flows.json
# Retention TTL (in hours) for learned DHCP leases in /app/state/dhcp_leases.json (default: 168 = 7 days)
DHCP_LEASE_TTL_HOURS=168
# Enable Reverse DNS (PTR) fallback for internal RFC1918 IPs not yet seen in DHCP syslog
ENABLE_PTR_FALLBACK=true
